local registry = {} -- { inst, prop, themeKey }
local buttons = {}  -- { btn, getNormal, getHover }

local FULL_H, HEAD_H = 262, 40

local function create(class, props, parent, binds)
    local inst = Instance.new(class)
    for k, v in pairs(props) do inst[k] = v end
    if binds then
        for prop, key in pairs(binds) do
            inst[prop] = Theme[key]
            table.insert(registry, {inst, prop, key})
        end
    end
    inst.Parent = parent
    return inst
end

local function corner(parent, r)
    return create("UICorner", {CornerRadius = UDim.new(0, r)}, parent)
end

local function stroke(parent, thickness, transparency)
    return create("UIStroke", {
        Thickness = thickness or 1,
        Transparency = transparency or 0,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
    }, parent, {Color = "Stroke"})
end

local function tween(inst, props, t)
    TweenService:Create(inst, TweenInfo.new(t or 0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props):Play()
end

local function styledButton(btn, getNormal, getHover)
    table.insert(buttons, {btn, getNormal, getHover})
    local press = create("UIScale", {Scale = 1}, btn)
    btn.MouseEnter:Connect(function() tween(btn, {BackgroundColor3 = getHover()}) end)
    btn.MouseLeave:Connect(function()
        tween(btn, {BackgroundColor3 = getNormal()})
        tween(press, {Scale = 1}, 0.12)
    end)
    btn.MouseButton1Down:Connect(function() tween(press, {Scale = 0.94}, 0.08) end)
    btn.MouseButton1Up:Connect(function() tween(press, {Scale = 1}, 0.15) end)
    btn.BackgroundColor3 = getNormal()
end

