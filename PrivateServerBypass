local toastCount = 0
local function notify(text, kind, duration)
    local color = Theme[kind] or Theme.Info
    toastCount += 1

    -- keep at most 4 toasts on screen
    local existing = {}
    for _, c in ipairs(ToastHolder:GetChildren()) do
        if c:IsA("CanvasGroup") then table.insert(existing, c) end
    end
    if #existing >= 4 then existing[1]:Destroy() end

    local toast = create("CanvasGroup", {
        Size = UDim2.new(1, 0, 0, 40),
        BorderSizePixel = 0,
        GroupTransparency = 1,
        LayoutOrder = toastCount,
    }, ToastHolder, {BackgroundColor3 = "Panel"})
    corner(toast, 8)
    stroke(toast, 1, 0.2)

    create("Frame", {
        Size = UDim2.new(0, 4, 1, 0),
        BackgroundColor3 = color,
        BorderSizePixel = 0,
    }, toast)

    create("TextLabel", {
        Position = UDim2.new(0, 14, 0, 0),
        Size = UDim2.new(1, -22, 1, 0),
        BackgroundTransparency = 1,
        Font = Enum.Font.GothamMedium,
        Text = text,
        TextSize = 12,
        TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, toast, {TextColor3 = "Text"})

    tween(toast, {GroupTransparency = 0}, 0.2)
    task.delay(duration or 3, function()
        if toast and toast.Parent then
            tween(toast, {GroupTransparency = 1}, 0.25)
            task.wait(0.3)
            if toast then toast:Destroy() end
        end
    end)
end

