-- ==============================
-- GLOW BUILDER (neon halo + drop shadow that follows a target)
-- ==============================
local function makeGlow(target, cornerR, strokeObj)
    local layers = {}
    local glow = {on = true}
    local centered = target.AnchorPoint.Y == 0.5

    local function add(pad, dy, targetT, isGlow)
        local f = create("Frame", {
            AnchorPoint = target.AnchorPoint,
            BackgroundColor3 = Color3.new(0, 0, 0),
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            ZIndex = 0,
        }, ScreenGui, isGlow and {BackgroundColor3 = "Glow"} or nil)
        corner(f, cornerR + pad / 2)
        table.insert(layers, {frame = f, pad = pad, dy = dy, t = targetT, glow = isGlow})
    end

    add(32, 0, 0.94, true)   -- outer halo
    add(22, 0, 0.87, true)
    add(12, 0, 0.74, true)   -- inner halo

    function glow.sync()
        for _, L in ipairs(layers) do
            local off = L.dy + (centered and 0 or -L.pad / 2)
            L.frame.Position = target.Position + UDim2.new(0, 0, 0, off)
            L.frame.Size = target.Size + UDim2.new(0, L.pad, 0, L.pad)
        end
    end
    target:GetPropertyChangedSignal("Position"):Connect(glow.sync)
    target:GetPropertyChangedSignal("Size"):Connect(glow.sync)
    glow.sync()

    function glow.setVisible(on)
        glow.on = on
        for _, L in ipairs(layers) do
            if on then L.frame.Visible = true end
            tween(L.frame, {BackgroundTransparency = on and L.t or 1}, 0.3)
        end
        if not on then
            task.delay(0.35, function()
                if not glow.on then
                    for _, L in ipairs(layers) do L.frame.Visible = false end
                end
            end)
        end
    end

    -- gentle breathing pulse
    task.spawn(function()
        while ScreenGui.Parent do
            if glow.on then
                for _, L in ipairs(layers) do
                    if L.glow then tween(L.frame, {BackgroundTransparency = L.t - 0.09}, 1.3) end
                end
                if strokeObj then tween(strokeObj, {Transparency = 0.3}, 1.3) end
                task.wait(1.3)
                if glow.on then
                    for _, L in ipairs(layers) do
                        if L.glow then tween(L.frame, {BackgroundTransparency = L.t}, 1.3) end
                    end
                    if strokeObj then tween(strokeObj, {Transparency = 0}, 1.3) end
                end
                task.wait(1.3)
            else
                task.wait(0.3)
            end
        end
    end)

    return glow
end

